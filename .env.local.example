# Copy this file to .env.local and fill in real values.
# .env.local is gitignored -- it never gets committed.
#
# Used only by `npm run refresh-auth` (scripts/refresh-auth.ts), which logs
# into tmwork.net on your behalf and pushes fresh TMWORK_COOKIE and
# TMWORK_API_TOKEN values to their GitHub secrets. Nothing here is used by
# the CI workflow itself -- that only reads GitHub Actions secrets.

# The "Code" field on tmwork's employee sign-in page (site/company code).
TMWORK_CODE=

# Your tmwork employee username.
TMWORK_USER=

# Your tmwork password. This sits in plaintext on your machine -- treat this
# file like a password vault, not just a config file.
TMWORK_PASSWORD=
